# graphify knowledge-graph MCP server for this project.
# Serves graphify-out/graph.json (built on the host) over the MCP HTTP transport.
# The graph is mounted read-only at runtime; this image only provides the server.
FROM python:3.12-slim

# The [mcp] extra pulls mcp + starlette + uvicorn, required for the HTTP transport.
RUN pip install --no-cache-dir "graphifyy[mcp]"

EXPOSE 8080
ENTRYPOINT ["graphify-mcp"]
# Overridable; the compose service pins the same args explicitly.
CMD ["/graph/graph.json", "--transport", "http", "--host", "0.0.0.0", "--port", "8080"]
